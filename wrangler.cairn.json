{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cairn-journal",
  "compatibility_date": "2026-10-27",
  "routes": [
    {
      "pattern": "cairn.bridgair.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/cairn",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
